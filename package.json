{
  "name": "vanta-launcher",
  "version": "1.3.0-beta.2",
  "description": "Vanta Launcher — Minecraft Java launcher with full loader version catalogs and LAN friends",
  "author": "Vanta Launcher",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:win:update": "node scripts/publish-github-release.cjs",
    "release:github": "node scripts/publish-github-release.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yauzl": "^3.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "wait-on": "^8.0.3",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "build": {
    "appId": "com.nebula.launcher",
    "productName": "Vanta Launcher",
    "artifactName": "Vanta-Launcher-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/vanta.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vanta Launcher",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "language": "1049",
      "displayLanguageSelector": false,
      "uninstallDisplayName": "Vanta Launcher ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "detectUpdateChannel": true,
    "generateUpdatesFilesForAllChannels": true,
    "electronUpdaterCompatibility": ">=6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
